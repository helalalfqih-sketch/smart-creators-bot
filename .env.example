# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── FastAPI server ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DOWNLOAD_API_URL=http://127.0.0.1:8000

# ── yt-dlp ────────────────────────────────────────────────────────────────────
DOWNLOAD_DIR=downloads
YTDLP_FORMAT=bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best
MAX_FILESIZE_MB=50
MAX_CONCURRENT_DOWNLOADS=3

# ── Smart Extractor / Cookies ─────────────────────────────────────────────────
COOKIES_DIR=assets/cookies
DOUYIN_COOKIES_PATH=assets/cookies/douyin.txt
TIKTOK_COOKIES_PATH=assets/cookies/tiktok.txt
EXTRACTOR_BROWSER=chrome
EXTRACTOR_RETRIES=3

# ── Redis (اختياري) ────────────────────────────────────────────────────────────
# إذا لم يكن Redis متاحاً، يتم الرجوع تلقائياً لـ memory cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# ── Private S3-compatible media storage ──────────────────────────────────────
# Required when API, Worker, and Bot run as separate production services.
MEDIA_STORAGE_DRIVER=local
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_TTL_SECONDS=900

# ── Misc ──────────────────────────────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO

# ── Video output (P0) ────────────────────────────────────────────────────────
VIDEO_OUTPUT_ENABLED=true
VIDEO_OUTPUT_RESOLUTION=4k
VIDEO_OUTPUT_FPS=60
VIDEO_OUTPUT_CODEC=hevc
VIDEO_OUTPUT_CRF=20
VIDEO_OUTPUT_PRESET=medium
VIDEO_OUTPUT_FIT=pad
VIDEO_FPS_MODE=duplicate
VIDEO_CONVERSION_TIMEOUT_SECONDS=1800
VIDEO_CONVERSION_CONCURRENCY=1
SEND_ANALYSIS_REPORT=false
SEND_ANALYSIS_TEXT_FILE=false
